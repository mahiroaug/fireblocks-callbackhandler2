# Copy to .env and adjust for your target AWS environment:
#   cp .env.example .env
#
# PROJECT_NAME and ENVIRONMENT must match existing CloudFormation stack exports
# when updating deployed infrastructure (e.g. e2e-monitor-cbh + stg).

PROJECT_NAME=e2e-monitor-cbh
ENVIRONMENT=stg
AWS_REGION=ap-northeast-1
AWS_PROFILE=stg_mtools_Infra_DEV
